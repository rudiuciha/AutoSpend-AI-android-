<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Claude API Key (opsional)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tanpa API key, app akan menggunakan regex parser (lebih cepat, tanpa internet). Dengan API key Claude, parsing lebih akurat."
        android:textSize="12sp"
        android:textColor="#666"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/et_api_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="sk-ant-..."
        android:textSize="14sp"
        android:inputType="textPassword"
        android:padding="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️ API key disimpan lokal di HP, tidak dikirim ke server lain."
        android:textSize="11sp"
        android:textColor="#888"
        android:layout_marginTop="8dp" />

</LinearLayout>
